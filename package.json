{
  "name": "accessassist",
  "version": "0.4.0",
  "description": "AccessAssist: ADA Title II / WCAG 2.1 AA document checker (ECE 30861 Team 19)",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "main": "src/server.js",
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26.0.0"
  },
  "scripts": {
    "start": "node src/server.js",
    "test": "NODE_ENV=test node --test --test-concurrency=1 \"test/**/*.test.js\"",
    "test:coverage": "NODE_ENV=test c8 --all --include='src/**/*.js' --reporter=text-summary --reporter=lcov node --test --test-concurrency=1 \"test/**/*.test.js\"",
    "test:remote": "NODE_ENV=test node --test test/contract.test.js",
    "evidence": "NODE_ENV=test node scripts/collect-evidence.js",
    "samples": "node scripts/export-samples.js",
    "lint": "eslint . --max-warnings 0",
    "lint:openapi": "redocly lint openapi.yaml",
    "audit": "npm audit --audit-level=high --omit=dev"
  },
  "dependencies": {
    "@xmldom/xmldom": "^0.9.12",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "express": "^4.22.3",
    "fflate": "^0.8.3",
    "jsdom": "^30.1.3",
    "multer": "^2.5.0",
    "pdf-lib": "^1.17.1",
    "yaml": "^2.9.1",
    "yauzl": "^3.4.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@redocly/cli": "^2.64.1",
    "c8": "^12.0.0",
    "eslint": "^9.39.5",
    "globals": "^17.13.0",
    "supertest": "^7.3.1"
  }
}
